FMouthTrack GetMouthTrack(EDialogueLine Line)
{
	switch (Line)
	{
	case EDialogueLine::HermitWarning:
		return {HermitWarningFrames, UE_ARRAY_COUNT(HermitWarningFrames), 1.530000f};
	case EDialogueLine::HermitShout:
		return {HermitShoutFrames, UE_ARRAY_COUNT(HermitShoutFrames), 1.030000f};
	case EDialogueLine::HermitPit:
		return {HermitPitFrames, UE_ARRAY_COUNT(HermitPitFrames), 1.207000f};
	case EDialogueLine::BanditDemand:
		return {BanditDemandFrames, UE_ARRAY_COUNT(BanditDemandFrames), 1.785000f};
	case EDialogueLine::BanditGold:
		return {BanditGoldFrames, UE_ARRAY_COUNT(BanditGoldFrames), 3.010000f};
	case EDialogueLine::BanditStay:
		return {BanditStayFrames, UE_ARRAY_COUNT(BanditStayFrames), 1.270000f};
	default:
		return {};
	}
}

FMouthTrack GetMouthTrack(EDialogueLine Line)
{
	switch (Line)
	{
	case EDialogueLine::HermitWarning:
		return {HermitWarningFrames, UE_ARRAY_COUNT(HermitWarningFrames), 2.807208f};
	case EDialogueLine::HermitShout:
		return {HermitShoutFrames, UE_ARRAY_COUNT(HermitShoutFrames), 1.456458f};
	case EDialogueLine::HermitPit:
		return {HermitPitFrames, UE_ARRAY_COUNT(HermitPitFrames), 1.386833f};
	case EDialogueLine::BanditDemand:
		return {BanditDemandFrames, UE_ARRAY_COUNT(BanditDemandFrames), 3.080000f};
	case EDialogueLine::BanditGold:
		return {BanditGoldFrames, UE_ARRAY_COUNT(BanditGoldFrames), 4.330000f};
	case EDialogueLine::BanditStay:
		return {BanditStayFrames, UE_ARRAY_COUNT(BanditStayFrames), 1.770000f};
	default:
		return {};
	}
}
